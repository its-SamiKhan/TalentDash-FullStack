// ─── DATASOURCE & GENERATOR ──────────────────────

datasource db {
  provider  = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
}

// ─── ENUMS ───────────────────────────────────────

enum Level {
  L3
  L4
  L5
  L6
  SDE_I
  SDE_II
  SDE_III
  STAFF
  PRINCIPAL
  IC4
  IC5
}

enum Currency {
  INR
  USD
  GBP
  EUR
}

enum Source {
  CONTRIBUTOR
  SCRAPED
  AI_INFERRED
}

// ─── MVP MODELS ──────────────────────────────────

model Company {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  normalizedName  String   @map("normalized_name")
  industry        String?
  headquarters    String?
  foundedYear     Int?     @map("founded_year")
  headcountRange  String?  @map("headcount_range")
  logoUrl         String?  @map("logo_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  salaries        Salary[]
  reviews         Review[]
  interviews      Interview[]
  communityPosts  CommunityPost[]
  workplaceScores WorkplaceScore[]

  @@index([normalizedName])
  @@map("companies")
}

model Salary {
  id                 String   @id @default(cuid())
  companyId          String   @map("company_id")
  company            Company  @relation(fields: [companyId], references: [id])
  role               String
  level              Level
  location           String
  currency           Currency
  experienceYears    Int      @map("experience_years")
  baseSalary         BigInt   @map("base_salary")
  bonus              BigInt   @default(0)
  stock              BigInt   @default(0)
  totalCompensation  BigInt   @map("total_compensation")
  source             Source   @default(CONTRIBUTOR)
  confidenceScore    Float    @default(1.0) @map("confidence_score")
  isVerified         Boolean  @default(false) @map("is_verified")
  submittedAt        DateTime @default(now()) @map("submitted_at")

  @@index([companyId, level, location])
  @@index([totalCompensation])
  @@index([submittedAt])
  @@index([location, level])
  @@map("salaries")
}

// ─── FUTURE STUB MODELS ─────────────────────────
// Empty tables created now to demonstrate architectural forethought.
// Full implementation in future iterations.

model Review {
  id                  String   @id @default(cuid())
  companyId           String   @map("company_id")
  company             Company  @relation(fields: [companyId], references: [id])
  role                String?
  rating              Int?                    // Overall rating (1-5)
  workLifeBalance     Int?     @map("work_life_balance")
  managementQuality   Int?     @map("management_quality")
  growthOpportunities Int?     @map("growth_opportunities")
  cultureFit          Int?     @map("culture_fit")
  title               String?
  pros                String?
  cons                String?
  isAnonymous         Boolean  @default(true) @map("is_anonymous")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([createdAt])
  @@map("reviews")
}

model Interview {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id])
  role         String?
  difficulty   Int?
  rounds       Int?
  outcome      String?
  experience   String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("interviews")
}

model CommunityPost {
  id        String   @id @default(cuid())
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])
  topic     String?
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("community_posts")
}

model WorkplaceScore {
  id                    String  @id @default(cuid())
  companyId             String  @unique @map("company_id")
  company               Company @relation(fields: [companyId], references: [id])
  compensationFairness  Float?  @map("compensation_fairness")
  careerGrowth          Float?  @map("career_growth")
  workLifeBalance       Float?  @map("work_life_balance")
  diversityInclusion    Float?  @map("diversity_inclusion")
  leadershipQuality     Float?  @map("leadership_quality")
  overallScore          Float?  @map("overall_score")

  @@map("workplace_scores")
}
